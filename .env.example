# Environment Variables for EduGap
# Copy this file to .env and set appropriate values for your environment
# Never commit real .env files with credentials to version control

# Application Port (Render sets this automatically)
PORT=8080

# PostgreSQL Database Configuration
# On Render, these will be provided by the PostgreSQL service
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/knowledge_gap_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT Authentication
# Generate a secure 256-bit (32-byte) hex secret for production
# The default below is for development only
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
# Update these for production deployment
# Render: https://your-service.onrender.com
# Vercel: https://your-app.vercel.app
# Local development: http://localhost:5173,http://localhost:4173,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:4173